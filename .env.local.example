# TMDB Read Access Token or v3 API key (add your own value)
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token
TMDB_API_KEY=your_tmdb_api_key

# Licensed anime API configuration (server-side only; never use NEXT_PUBLIC_*).
# Replace the base URL and endpoint paths with the values from your provider.
ANIME_API_BASE_URL=https://your-licensed-anime-api.example
ANIME_API_KEY=
ANIME_API_HOME_PATH=/anime/home
ANIME_API_SCHEDULE_PATH=/anime/schedule
ANIME_API_DETAIL_PATH=/anime/anime/{slug}
ANIME_API_COMPLETE_PATH=/anime/complete-anime?page={page}
ANIME_API_ONGOING_PATH=/anime/ongoing-anime?page={page}
ANIME_API_GENRES_PATH=/anime/genre
ANIME_API_GENRE_DETAIL_PATH=/anime/genre/{slug}?page={page}
ANIME_API_EPISODE_PATH=/anime/episode/{slug}
ANIME_API_SEARCH_PATH=/anime/search/{keyword}
ANIME_API_BATCH_PATH=/anime/batch/{slug}
ANIME_API_STREAM_SERVER_PATH=/anime/server/{serverId}
ANIME_API_ALL_PATH=/anime/unlimited

# Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional video provider configuration
VIDSRC_BASE_URL=https://vidsrc.to/embed
VIDSRC_DEFAULT_SERVER=vidsrc.to
VIDSRC_API_KEY=

VIDEO_PROVIDER_API_URL=https://vidsrc.to/embed
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_EMBED_TEMPLATE=https://vidsrc.to/embed/{type}/{id}
VIDEO_PROVIDER_EMBED_HOSTS=vidsrc.to,vidsrc.me,vidsrc.xyz,vidsrc.cc,vidsrc.rip,vidsrc.pm,vidsrc.in,vidsrc.net,player.vidsrc.to

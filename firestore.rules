rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ys309700@gmail.com';
    }

    function avatarCatalogPath() {
      return /databases/$(database)/documents/settings/avatarCatalog;
    }

    function profileBannerCatalogPath() {
      return /databases/$(database)/documents/settings/profileBannerCatalog;
    }

    function allowedAvatar(url) {
      return url.matches('^/avatars/avatar-(red|teal|gold|blue|green|pink)\\.svg$')
        || (exists(avatarCatalogPath()) && get(avatarCatalogPath()).data.urls.hasAny([url]));
    }

    function allowedProfileBanner(url) {
      return url == ''
        || (exists(profileBannerCatalogPath()) && get(profileBannerCatalogPath()).data.urls.hasAny([url]));
    }

    match /users/{userId} {
      function isOwner() {
        return signedIn() && request.auth.uid == userId;
      }

      function validProfile() {
        return request.resource.data.keys().hasOnly([
            'displayName', 'bio', 'gender', 'avatarUrl', 'bannerUrl', 'email', 'isBanned',
            'level', 'xpPoints', 'lastRewardId', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 280
          && request.resource.data.gender in [
            'Belum dipilih', 'Perempuan', 'Laki-laki', 'Non-biner', 'Tidak ingin menyebutkan'
          ]
          && request.resource.data.avatarUrl is string
          && allowedAvatar(request.resource.data.avatarUrl)
          && request.resource.data.bannerUrl is string
          && allowedProfileBanner(request.resource.data.bannerUrl)
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.isBanned is bool
          && request.resource.data.get('level', 1) is int
          && request.resource.data.get('level', 1) >= 1
          && request.resource.data.get('level', 1) <= 1000000
          && request.resource.data.get('xpPoints', 0) is int
          && request.resource.data.get('lastRewardId', '') is string;
      }

      function validWatchRewardUpdate() {
        let rewardId = request.resource.data.lastRewardId;
        let rewardPath = /databases/$(database)/documents/users/$(userId)/watchRewards/$(rewardId);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'level', 'xpPoints', 'lastRewardId', 'updatedAt'
          ])
          && request.resource.data.xpPoints is int
          && request.resource.data.xpPoints >= 0
          && request.resource.data.xpPoints <= 9007199254740991
          && request.resource.data.level is int
          && (!resource.data.keys().hasAny(['level'])
            || (request.resource.data.level >= resource.data.get('level', 1)
              && request.resource.data.level <= resource.data.get('level', 1) + 1
              && (request.resource.data.level == resource.data.get('level', 1)
                ? request.resource.data.xpPoints == resource.data.get('xpPoints', 0) + 150
                : request.resource.data.xpPoints == 0)))
          && request.resource.data.lastRewardId is string
          && !exists(rewardPath)
          && existsAfter(rewardPath)
          && getAfter(rewardPath).data.points == 150
          && getAfter(rewardPath).data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if isOwner() || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner()
        && validProfile()
        && request.resource.data.isBanned == false
        && request.resource.data.get('level', 1) == 1
        && request.resource.data.get('xpPoints', 0) == 0
        && request.resource.data.get('lastRewardId', '') == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isOwner()
          && validProfile()
          && request.resource.data.email == resource.data.email
          && request.resource.data.isBanned == resource.data.isBanned
          && request.resource.data.get('level', 1) == resource.data.get('level', 1)
          && request.resource.data.get('xpPoints', 0) == resource.data.get('xpPoints', 0)
          && request.resource.data.get('lastRewardId', '') == resource.data.get('lastRewardId', '')
          && request.resource.data.createdAt == resource.data.createdAt)
        || (isOwner() && validWatchRewardUpdate())
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBanned', 'level', 'xpPoints', 'updatedAt'])
          && request.resource.data.get('isBanned', resource.data.get('isBanned', false)) is bool
          && request.resource.data.get('level', resource.data.get('level', 1)) is int
          && request.resource.data.get('level', resource.data.get('level', 1)) >= 1
          && request.resource.data.get('level', resource.data.get('level', 1)) <= 1000000
          && request.resource.data.get('xpPoints', resource.data.get('xpPoints', 0)) is int
          && request.resource.data.get('xpPoints', resource.data.get('xpPoints', 0)) >= 0
          && request.resource.data.updatedAt == request.time);
      allow delete: if false;

      match /watchRewards/{rewardId} {
        allow get, list: if isOwner() || isAdmin();
        allow create: if isOwner()
          && request.resource.data.keys().hasOnly(['contentKey', 'points', 'createdAt'])
          && request.resource.data.contentKey is string
          && request.resource.data.contentKey.size() <= 256
          && request.resource.data.points == 150
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /settings/avatarCatalog {
      allow get, list: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['urls', 'updatedAt'])
        && request.resource.data.urls is list
        && request.resource.data.urls.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /settings/profileBannerCatalog {
      allow get, list: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['urls', 'updatedAt'])
        && request.resource.data.urls is list
        && request.resource.data.urls.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}